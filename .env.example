# Local PostgreSQL via `docker compose up -d db` (change for hosted PostgreSQL).
DATABASE_URL=postgresql://nextora:nextora-local-only@127.0.0.1:54330/invoicing
# Origin of the web application. Sessions and CSRF checks are pinned to this origin.
APP_URL=http://localhost:5174
API_PORT=8888
# Generate for production: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# One-time bootstrap only. Remove OWNER_PASSWORD immediately afterwards.
OWNER_EMAIL=
OWNER_PASSWORD=
